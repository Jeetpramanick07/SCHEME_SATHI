# SchemeSaathi Voice & Accessibility Service Configuration
# Copy this file to .env and adjust values as needed

# Server Port and Host
PORT=8000
HOST=0.0.0.0

# Mock Mode (set to 'true' for CI/dev environments without GPU or downloaded AI4Bharat model weights)
MOCK_VOICE=false

# Compute Device: 'cuda' for GPU, 'cpu' for standard CPU inference
DEVICE=cpu

# Audio Sample Rate (AI4Bharat IndicConformer and Parler TTS standard)
AUDIO_SAMPLE_RATE=16000
