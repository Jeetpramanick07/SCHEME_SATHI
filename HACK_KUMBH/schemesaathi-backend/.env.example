# Server configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Allowed web origins for CORS (comma-separated or *)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database connection string (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:your_db_password_here@localhost:5432/schemesaathi
DB_SSL_REJECT_UNAUTHORIZED=true

# Days before unverified / draft records are considered stale
STALE_DAYS=90

# API Authorization Keys (Set strong random secrets in production)
API_KEY_CITIZEN=your_citizen_api_key_here
API_KEY_VOLUNTEER=your_volunteer_api_key_here
API_KEY_ADMIN=your_admin_api_key_here

# SMS Provider: simulated (default) | msg91 | twilio
SMS_PROVIDER=simulated
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_template_id_here
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_FROM_PHONE=+1234567890

# Optional Indic Voice Microservice (Piper TTS / Whisper STT)
INDIC_VOICE_URL=http://localhost:8000
