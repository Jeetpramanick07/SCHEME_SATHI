# SchemeSaathi Backend Environment Variables
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database connection: PostgreSQL connection string (Neon, Supabase, AWS RDS, Docker)
# Embedded PGlite fallback is automatically activated if PostgreSQL is unreachable
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/schemesaathi

# Set to true for production or cloud SSL connections
DB_SSL_REJECT_UNAUTHORIZED=true

# Cache staleness window in days
STALE_DAYS=90

# API Authentication Keys
API_KEY_CITIZEN=citizen-secret-key
API_KEY_ADMIN=admin-secret-key
