{
  "name": "schemesaathi-backend",
  "version": "1.0.0",
  "description": "Multilingual government welfare-scheme assistant backend (Nagpur/Vidarbha, Maharashtra)",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "ingest": "tsx src/ingest/cli.ts",
    "seed": "tsx src/seed/seed.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "bench": "tsx src/bench/bench.ts",
    "bench:cleanup": "tsx scripts/bench-cleanup.ts",
    "import-dataset": "tsx scripts/import-dataset.ts",
    "voice:precompute": "tsx src/modules/voice/accessibility/precompute-scheme-audio.ts",
    "seed:demo-ngo": "tsx src/seed/demo-ngo.ts",
    "demo:reset": "tsx src/db/migrate.ts && tsx src/seed/seed.ts && tsx src/seed/demo-ngo.ts --reset"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^10.1.9",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
